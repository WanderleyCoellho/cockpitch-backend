generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  /// Nulo para quem só entra com Google.
  passwordHash         String?
  /// Identificador da conta Google (claim "sub"), quando vinculada.
  googleSub            String?           @unique
  /// Guia de primeiros passos: tours vistos, checklist oculto, link compartilhado (spec in-app-guidance).
  onboarding           Json?
  name                 String
  role                 UserRole          @default(PROVIDER)
  planTier             PlanTier          @default(FREE)
  billingStatus        BillingStatus     @default(INACTIVE)
  licensePolicy        LicensePolicy     @default(STANDARD)
  licensePolicyNote    String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  providers            Provider[]
  paymentReceipts      PaymentReceipt[]
  memberships          WorkspaceMember[]
  invitesSent          WorkspaceInvite[] @relation("InviteSender")
}

/// Unidade de conta, cobrança e limites (empresa ou profissional autônomo).
/// Os campos de cobrança em User ficam congelados (legado) e serão removidos depois.
model Workspace {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  segment              WorkspaceSegment   @default(GENERAL)
  logoUrl              String?
  brandColor           String?
  locale               String             @default("pt-BR")
  currency             String             @default("BRL")
  planTier             PlanTier           @default(FREE)
  billingStatus        BillingStatus      @default(INACTIVE)
  licensePolicy        LicensePolicy      @default(STANDARD)
  licensePolicyNote    String?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?
  /// Cancelamento agendado no Stripe (vale até o fim do período pago).
  subscriptionCancelAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  events               WorkspaceEvent[]
  members              WorkspaceMember[]
  invites              WorkspaceInvite[]
  providers            Provider[]
  templates            ProposalTemplate[]
  savedBlocks          SavedBlock[]
}

/// Histórico de cobrança e licença da empresa (painel Ops).
model WorkspaceEvent {
  id          String             @id @default(cuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        WorkspaceEventType
  /// Detalhes do evento (plano anterior/novo, data, observação).
  detail      Json?
  createdAt   DateTime           @default(now())

  @@index([workspaceId, createdAt])
  @@index([type, createdAt])
}

enum WorkspaceEventType {
  SUBSCRIBED
  PLAN_CHANGED
  PAYMENT_FAILED
  PAYMENT_RECOVERED
  CANCEL_SCHEDULED
  CANCEL_REVERTED
  CANCELED
  COURTESY_GRANTED
  COURTESY_REVOKED
  LICENSE_CHANGED
}

/// Avisos recebidos do Stripe (webhook), para o painel Ops e diagnóstico.
model StripeEventLog {
  /// ID do evento no Stripe (evt_...): reenvios do mesmo evento não duplicam.
  id         String   @id
  type       String
  customerId String?
  /// synced | ignored | unknown_customer | error
  outcome    String
  error      String?
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

/// Modelo de proposta salvo por uma empresa (os modelos do sistema ficam no código).
model ProposalTemplate {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  segment     WorkspaceSegment @default(GENERAL)
  blocks      Json
  theme       String?
  themeCustom Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId])
}

/// Bloco salvo na biblioteca da empresa (Profissional/Equipe), compartilhado com a equipe.
model SavedBlock {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  type        String
  block       Json
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model WorkspaceMember {
  id               String        @id @default(cuid())
  workspaceId      String
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             WorkspaceRole @default(MEMBER)
  /// Preferências de e-mail desta pessoa nesta empresa.
  notifyOnOpen     Boolean       @default(true)
  notifyOnResponse Boolean       @default(true)
  createdAt        DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  invitedBy   User?         @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([workspaceId])
}

model PaymentReceipt {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl              String
  storedFilename       String
  originalFilename     String
  mimeType             String
  status               ReceiptStatus    @default(SUBMITTED)
  riskLevel            ReceiptRiskLevel @default(MEDIUM)
  analysisSummary      String?
  extractedText        String?
  detectedAmount       String?
  detectedTransferDate String?
  payerName            String?
  recipientName        String?
  reviewerName         String?
  reviewerNotes        String?
  reviewedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

model Provider {
  id                  String     @id @default(cuid())
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId         String?
  workspace           Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String
  email               String
  whatsapp            String?
  instagram           String?
  city                String?
  logoUrl             String?
  photoUrl            String?
  shortDescription    String?
  aboutTitle          String?
  aboutSubtitle       String?
  aboutText           String?
  styleText           String?
  heroVideoUrl        String?
  deliveryTimes       String?
  differentialsTitle  String?
  differentialsText   String?
  chips               Json?
  testimonials        Json?
  differentialsMedia  Json?
  aboutPortfolioMedia Json?
  partners            Json?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  packages            Package[]
  proposals           Proposal[]
  packageLabel        String?
  contactInfo         Json?

  @@index([userId])
  @@index([workspaceId])
}

model Package {
  id              String           @id @default(cuid())
  providerId      String
  provider        Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  /// Legado/exibição: total calculado em reais ("3500.00"), mantido pelo servidor a cada alteração.
  price           String
  priceMode       PackagePriceMode @default(FIXED)
  /// Valor fixo em centavos (priceMode = FIXED).
  fixedPriceCents Int?
  discountType    DiscountType     @default(NONE)
  /// PERCENT: pontos-base (1000 = 10%). AMOUNT: centavos.
  discountValue   Int              @default(0)
  /// Texto opcional exibido junto ao preço (ex.: "a partir de", "por pessoa").
  priceLabel      String?
  isHighlighted   Boolean          @default(false)
  highlightLabel  String?
  highlightColor  String?
  order           Int              @default(0)
  mediaUrl        String?
  mediaType       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           PackageItem[]
  proposals       Proposal[]       @relation("ProposalPackages")

  @@index([providerId])
}

model PackageItem {
  id             String          @id @default(cuid())
  packageId      String
  package        Package         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  /// Legado: espelho de kind = COURTESY.
  isCourtesy     Boolean         @default(false)
  kind           PackageItemKind @default(INCLUDED)
  quantity       Decimal         @default(1) @db.Decimal(12, 2)
  /// Unidade exibida (ex.: "h", "un", "diária").
  unit           String?
  unitPriceCents Int             @default(0)
  order          Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([packageId])
}

model Proposal {
  id                 String             @id @default(cuid())
  providerId         String
  provider           Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  clientName         String
  slug               String             @unique
  serviceDate        String?
  validityDays       Int                @default(30)
  status             ProposalStatus     @default(ABERTA)
  commercialStatus   CommercialStatus   @default(SEM_RESPOSTA)
  heroVideoUrl       String?
  weddingPhotoUrl    String?
  theme              String?            @default("dark_luxury")
  themeCustom        Json?
  sections           Json?
  backstageMedia     Json?
  differentialsMedia Json?
  videoSoundEnabled  Boolean            @default(false)
  sectionsConfig     Json?
  /// Proposta em blocos (spec 003). Nulo = proposta antiga, exibida com o layout legado.
  blocks             Json?
  blocksVersion      Int                @default(1)
  /// Modelo usado na criação (sys-* do sistema ou id de ProposalTemplate).
  templateId         String?
  /// Quando o link foi copiado/compartilhado pelo painel (conta como "enviada" no Analytics).
  sharedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  packageIds         Package[]          @relation("ProposalPackages")
  views              ProposalView[]
  responses          ProposalResponse[]

  @@index([providerId])
  @@index([slug])
}

/// Resposta do cliente na página pública (spec proposal-online-acceptance). Evidência imutável.
model ProposalResponse {
  id             String               @id @default(cuid())
  proposalId     String
  proposal       Proposal             @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  type           ProposalResponseType
  signerName     String
  signerEmail    String
  signerDocument String?
  message        String?
  /// Pacote e opcionais escolhidos, com nomes e valores no momento da resposta.
  selection      Json?
  /// Total calculado no servidor no momento da resposta (centavos).
  totalCents     Int?
  /// SHA-256 do conteúdo exibido (blocos + pacotes) + seleção.
  contentHash    String
  ip             String?
  userAgent      String?
  createdAt      DateTime             @default(now())

  @@index([proposalId, createdAt])
}

enum ProposalResponseType {
  ACCEPTED
  DECLINED
  CHANGE_REQUESTED
}

model ProposalView {
  id           String   @id @default(cuid())
  proposalId   String
  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalSlug String
  sessionId    String
  viewedAt     DateTime

  @@index([proposalId])
  @@index([proposalSlug])
}

enum UserRole {
  PROVIDER
  CUSTOMER
  ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceSegment {
  PHOTO_VIDEO
  EVENTS
  AGENCY
  CONSULTING
  HEALTH_BEAUTY
  CONSTRUCTION
  EDUCATION
  TECH
  GENERAL
}

enum PackagePriceMode {
  SUM_OF_ITEMS
  FIXED
  ON_REQUEST
}

enum DiscountType {
  NONE
  PERCENT
  AMOUNT
}

enum PackageItemKind {
  INCLUDED
  OPTIONAL
  COURTESY
}

enum ProposalStatus {
  ABERTA
  FECHADA
  EXPIRADA
  ARQUIVADA
}

enum CommercialStatus {
  SEM_RESPOSTA
  NEGOCIANDO
  ACEITA
  NEGADA
  PERSONALIZADO
}

enum PlanTier {
  FREE
  STARTER
  PRO
  AGENCY
}

enum BillingStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum LicensePolicy {
  STANDARD
  COURTESY
}

enum ReceiptStatus {
  SUBMITTED
  ANALYZED
  NEEDS_HUMAN_REVIEW
  APPROVED
  REJECTED
}

enum ReceiptRiskLevel {
  LOW
  MEDIUM
  HIGH
}

/// Fila de e-mails (spec email-notifications): gravada na mesma transação do evento e enviada por um job com retry.
model EmailOutbox {
  id            String      @id @default(cuid())
  to            String
  template      String
  payload       Json
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  /// Impede e-mails repetidos para o mesmo evento e destinatário.
  dedupeKey     String      @unique
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([status, nextAttemptAt])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}
